[global]
    width = 400
    offset = 5x5
    
    progress_bar_min_width = 380
    progress_bar_max_width = 380
    progress_bar_corner_radius = 2

    padding = 10
    horizontal_padding = 10
    frame_width = 1
    gap_size = 3
    font = "JetBrains Mono 10"

    icon_theme = "Papirus"
    enable_recursive_icon_lookup = true
    corner_radius = 2

    max_icon_size = 20

    background = "#26233a"
    foreground = "#e0def4"

    origin = bottom-right

[urgency_low]
    background = "#26273d"
    highlight = "#34d87e"
    frame_color = "#34d87e"
    default_icon = "dialog-information"
    format = "<b><span foreground='#34d87e'>%s</span></b>\n%b"

[urgency_normal]
    background = "#362e3c"
    highlight = "#34d87e"
    frame_color = "#34d87e"
    default_icon = "dialog-warning"
    format = "<b><span foreground='#34d87e'>%s</span></b>\n%b"

[urgency_critical]
    background = "#35263d"
    highlight = "#eb6f92"
    frame_color = "#eb6f92"
    default_icon = "dialog-error"
    format = "<b><span foreground='#eb6f92'>%s</span></b>\n%b"